# Target: original ESP32 (AI-Thinker ESP32-CAM) — not the S3 the hub uses.
CONFIG_IDF_TARGET="esp32"

# Flash (AI-Thinker boards are commonly 4MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# PSRAM — AI-Thinker boards have 4MB quad SPI PSRAM, needed for JPEG
# framebuffers. Exact Kconfig symbol names have shifted a little across
# ESP-IDF v5.x point releases; if the build doesn't detect PSRAM, check
# `idf.py menuconfig` → Component config → ESP PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
